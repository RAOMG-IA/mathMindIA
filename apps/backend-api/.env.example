PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/mathmindia
REDIS_URL=redis://localhost:6379
JWT_SECRET=

# Allowlist explicita de origenes externos admitidos por CORS (separados por comas, sin
# wildcard -- ver corsConfig.ts). Sin definir, ningun origin de navegador pasa (privacidad por
# defecto); no afecta a apps nativas iOS/Android ni a curl/servidor-a-servidor, que no envian
# cabecera Origin. Ejemplo para desarrollo local con mobile-app en Expo Web:
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
CORS_ALLOWED_ORIGINS=

#LLM configuration -- cualquier endpoint compatible con la API de OpenAI (Qwen/DashScope,
# DeepSeek, Grok, etc.), ver LangChainChatModel.ts. Verificado en la practica con mas de un
# proveedor -- por eso las variables ya no se llaman QWEN_* (renombradas 2026-08-08).
#
# Hugging Face Inference Providers como fuente de modelos publicos
#
# Se adopta Hugging Face Inference Providers (router serverless, compatible con OpenAI) como
# fuente de los LLM del agente. El router expone un endpoint chat/completions OpenAI-compatible:
#
# | Variable       | Valor para Hugging Face                                                  |
# |----------------|----------------------------------------------------------------------------|
# | AI_BASE_URL    | https://router.huggingface.co/v1                                         |
# | AI_API_KEY     | Token de Hugging Face (o de un proveedor partner, p.ej. :baseten)        |
# | AI_MODEL_NAME  | ID de un modelo de pesos abiertos, opcionalmente con sufijo de           |
# |                | proveedor/politica (p.ej. Qwen/Qwen2.5-7B-Instruct:preferred o           |
# |                | deepseek-ai/DeepSeek-V4-Flash-0731:baseten)                              |
AI_API_KEY=
AI_BASE_URL=
# Opcional -- nombre del modelo, default 'qwen-plus' (historico) si se deja vacio.
AI_MODEL_NAME=

# RAG (UC-011, ver docs/ADR/ADR-014_rag.md) -- directorios del script de ingesta.
# Sin variable de almacen vectorial: pgvector reutiliza el DATABASE_URL de arriba.
RAG_INPUT_DIR=
RAG_HISTORY_DIR=
RAG_CRON_SCHEDULE=

# Generacion de ejercicios por lote (UC-001, npm run generate:exercises) -- opcionales, todas
# vacias por defecto: genera para el catalogo COMPLETO de Temas (ADR-006) x sus niveles x
# Test/Resolution si no se filtra. Ver apps/backend-api/src/scripts/generateExerciseBatch.ts.
# EXERCISE_BATCH_TEMA=arit.fracciones,arit.decimales
# EXERCISE_BATCH_LEVEL=Primaria
# EXERCISE_BATCH_TYPE=Resolution
# EXERCISE_BATCH_COUNT=1
# Ritmo/reintentos ante 429 (rate limit) del proveedor -- defaults razonables para planes
# gratuitos, bajalos si tu proveedor admite mas peticiones/minuto.
# EXERCISE_BATCH_DELAY_MS=3000
# EXERCISE_BATCH_RATE_LIMIT_RETRIES=5
# EXERCISE_BATCH_RATE_LIMIT_DELAY_MS=10000
