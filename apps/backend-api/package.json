{
  "name": "@mathmind/backend-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/presentation/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/presentation/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "ingest:rag": "tsx src/scripts/ingestKnowledgeBase.ts"
  },
  "dependencies": {
    "@mathmind/ai-engine": "*",
    "@mathmind/shared-config": "*",
    "@mathmind/shared-constants": "*",
    "@mathmind/shared-domain": "*",
    "@mathmind/shared-types": "*",
    "@mathmind/shared-utils": "*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@mathmind/shared-testing": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.0",
    "prisma": "^7.9.1",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
