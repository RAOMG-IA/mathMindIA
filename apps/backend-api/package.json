{
  "name": "@mathmind/backend-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/presentation/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/presentation/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "express": "^4.21.0",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "@mathmind/shared-domain": "*",
    "@mathmind/shared-types": "*",
    "@mathmind/shared-config": "*",
    "@mathmind/shared-constants": "*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "prisma": "^7.9.1",
    "@mathmind/shared-testing": "*"
  }
}
