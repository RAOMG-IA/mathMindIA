# Variables de docker compose (ADR-016). Copia a .env y ajusta si quieres.
# Los secretos reales (AI_API_KEY, JWT_SECRET) NUNCA se versionan (ADR-012).

# --- PostgreSQL (imagen pgvector/pgvector:pg16) ---
POSTGRES_USER=mathmind
POSTGRES_PASSWORD=mathmind
POSTGRES_DB=mathmindia
# Si tu Postgres local ocupa 5432, usa otro puerto (p. ej. 5433) o para el servicio.
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Aplicacion (contenedor node) ---
APP_PORT=3000
# Solo desarrollo. En produccion real se inyecta desde el entorno (ADR-012).
JWT_SECRET=

# --- LLM (opcional en dev; sin valor, POST /hints falla con error claro) ---
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_NAME=

# --- RAG (UC-011 / ADR-014): directorios montados en ./rag/{input,history} ---
RAG_INPUT_DIR=/workspace/rag/input
RAG_HISTORY_DIR=/workspace/rag/history
